{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0.2",
        "consoletvs/charts": "6.*",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.4",
        "laravel/framework": "^9.2",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^3.4",
        "laravelcollective/html": "^6.2",
        "rtconner/laravel-tagging": "^4.1",
        "simplesoftwareio/simple-qrcode": "^2.0",
        "spatie/laravel-permission": "^5.0",
        "yajra/laravel-datatables-oracle": "^10.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "beyondcode/laravel-er-diagram-generator": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": {"apply": "block", "reason": "Laravel 9 is EOL; CRLF in email rule is fixed only in 12.60+. Remove when upgrading past Laravel 12.60."},
                "PKSA-3r5d-mb8f-1qw9": {"apply": "block", "reason": "Laravel 9 is EOL; CRLF in email rule is fixed only in 12.60+. Remove when upgrading past Laravel 12.60."},
                "PKSA-m5cs-t1y6-qpcs": {"apply": "block", "reason": "Laravel 9 is EOL; signed URL path confusion is fixed only in 12.61.1+. Remove when upgrading past Laravel 12.61.1."},
                "PKSA-d5tc-s1qs-h781": {"apply": "block", "reason": "Laravel 9 is EOL; debug page XSS is fixed only in 12.69+ and needs APP_DEBUG=true. Remove when upgrading past Laravel 12.69."},
                "PKSA-8qx3-n5y5-vvnd": {"apply": "block", "reason": "Laravel 9 is EOL; file validation bypass is fixed only in 10.48.29+. Remove when upgrading to Laravel 10."}
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
